# ============================================================
# dwell-backend 环境变量清单（Sealos 应用「高级配置-环境变量」填写）
# 复制为 .env.sealos 并按实填写；LLM_API_KEY 建议用 Secret 注入
# ============================================================

# --- 应用运行 ---
DEBUG=false
LOG_LEVEL=INFO
# SQLite 路径必须指向 PVC 挂载点（dwell-data -> /app/backend/data）
SKU_DB_PATH=/app/backend/data/sku.db

# --- 国内模型配置（示例为兼容 OpenAI 协议的国内服务商，按实际服务商调整）---
LLM_PROVIDER=<LLM_PROVIDER>            # 如 zhipu / moonshot / qwen / openai-compatible
LLM_BASE_URL=<LLM_BASE_URL>            # 如 https://api.zhipuai.com/api/paas/v4
LLM_API_KEY=<LLM_API_KEY>              # 敏感，建议放入 Secret
LLM_MODEL=<LLM_MODEL>                  # 文本/规划模型名
LLM_VISION_MODEL=<LLM_VISION_MODEL>    # 图片理解模型名
LLM_IMAGE_MODEL=<LLM_IMAGE_MODEL>      # 图片生成模型名（如无则留空）
