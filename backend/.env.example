# Gemini Developer API（可选：未配置时优先走国内 Provider）
GOOGLE_API_KEY=your_api_key_here

# Model names
VISION_MODEL_NAME=gemini-3-pro
PLANNING_MODEL_NAME=gemini-2.5-pro
LAYOUT_IMAGE_MODEL_NAME=gemini-3-pro-image-preview
RENDER_IMAGE_MODEL_NAME=gemini-2.5-flash-image

# 国内模型 Provider（OpenAI 兼容协议，优先于 Gemini；留空则回退 Gemini / 规则降级）
# DeepSeek:  LLM_BASE_URL=https://api.deepseek.com/v1             LLM_MODEL=deepseek-chat
# 通义千问:   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus  LLM_VISION_MODEL=qwen-vl-max
# 智谱 GLM:   LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4    LLM_MODEL=glm-4-plus     LLM_VISION_MODEL=glm-4v-plus
# 腾讯混元:   LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1  LLM_MODEL=hunyuan-turbo  LLM_VISION_MODEL=hunyuan-vision
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_VISION_MODEL=
# 生图模型（国内，走 OpenAI 兼容 images API）：通义万相 wanx2.1-t2i-turbo / 智谱 cogview-4
LLM_IMAGE_MODEL=

# 门店 SKU 库（SQLite，默认 backend/data/sku.db）
SKU_DB_PATH=

# LangSmith Tracing (optional - for agent observability)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=pocket-planner

# Logging
LOG_LEVEL=INFO
